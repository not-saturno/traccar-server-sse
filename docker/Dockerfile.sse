# Image for this fork: backend + front (traccar-web / gps-tracker-front) + Java runtime from jlink.
# Build from the repository root, with the traccar-web submodule initialized:
#   docker build -f docker/Dockerfile.sse -t traccar-sse .

FROM node:22-alpine AS front
WORKDIR /front
COPY traccar-web/package.json traccar-web/package-lock.json ./
RUN npm ci
COPY traccar-web/ ./
RUN npm run build

FROM eclipse-temurin:21-jdk AS backend
WORKDIR /build
COPY gradlew build.gradle settings.gradle openapi.yaml ./
COPY gradle gradle
COPY src src
RUN ./gradlew --no-daemon assemble

FROM eclipse-temurin:21-jdk AS jre
RUN jlink --add-modules java.se,jdk.charsets,jdk.crypto.ec,jdk.net,jdk.unsupported \
    --strip-debug --no-header-files --no-man-pages --compress=zip-6 --output /jre

FROM debian:stable-slim
WORKDIR /opt/traccar
COPY --from=jre /jre jre
COPY --from=backend /build/target/tracker-server.jar ./
COPY --from=backend /build/target/lib lib
COPY --from=front /front/dist web
COPY schema schema
COPY templates templates
COPY setup/traccar.xml conf/traccar.xml
RUN mkdir -p data logs
EXPOSE 8082 5055
ENTRYPOINT ["/opt/traccar/jre/bin/java", "-XX:+ExitOnOutOfMemoryError"]
CMD ["-jar", "tracker-server.jar", "conf/traccar.xml"]
