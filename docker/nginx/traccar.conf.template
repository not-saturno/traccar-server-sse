# Reverse proxy for traccar-server-sse: front, REST API, SSE streams, WebSocket and OsmAnd over HTTPS.
# See docs/deploy.md.
#
# Variables, filled by envsubst (the nginx Docker image does it on startup for /etc/nginx/templates/*.template):
#   SERVER_NAME       public domain, e.g. onibus.exemplo.ufpa.br
#   TRACCAR_UPSTREAM  Traccar web port: 127.0.0.1:8082 (nginx on the host) or traccar:8082 (nginx in compose)
#
# nginx on the host:
#   SERVER_NAME=onibus.exemplo.ufpa.br TRACCAR_UPSTREAM=127.0.0.1:8082 \
#     envsubst '${SERVER_NAME} ${TRACCAR_UPSTREAM}' < traccar.conf.template > /etc/nginx/sites-available/traccar

upstream traccar {
    server ${TRACCAR_UPSTREAM};
    keepalive 16;
}

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      '';
}

server {
    listen 80;
    listen [::]:80;
    server_name ${SERVER_NAME};

    # Let's Encrypt HTTP-01 challenge (certbot --webroot -w /var/www/certbot)
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    # HTTP/2 removes the browser limit of 6 SSE connections per domain
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name ${SERVER_NAME};

    ssl_certificate     /etc/letsencrypt/live/${SERVER_NAME}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${SERVER_NAME}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:10m;

    client_max_body_size 10m;

    # Traccar does not mark the session cookie as Secure behind a TLS proxy
    proxy_cookie_flags JSESSIONID secure;

    # Inherited by every location below that does not set its own proxy_set_header
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    # Traccar reads CF-Connecting-IP before X-Real-IP, so drop any value sent by the client
    proxy_set_header CF-Connecting-IP "";
    proxy_set_header Connection "";

    # SSE: /api/sse (logged in) and /api/public/stream (visitors).
    # Traccar sends a keepalive every 55 s, so the read timeout must be longer than that.
    location ~ ^/api/(sse|public/stream)$ {
        proxy_pass http://traccar;
        proxy_buffering off;
        proxy_cache off;
        gzip off;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }

    # Traccar WebSocket (official apps and the upstream traccar-web)
    location = /api/socket {
        proxy_pass http://traccar;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header CF-Connecting-IP "";
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 1h;
    }

    # Front (served by Traccar from web/), REST API and OsmAnd over HTTPS (POST /)
    location / {
        proxy_pass http://traccar;
    }
}
