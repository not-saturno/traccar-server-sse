<?xml version='1.0' encoding='UTF-8'?>

<!DOCTYPE properties SYSTEM 'http://java.sun.com/dtd/properties.dtd'>

<properties>

    <!-- Production config for docker/compose/traccar-sse.yaml. See docs/deploy.md. -->

    <entry key='database.driver'>org.h2.Driver</entry>
    <entry key='database.url'>jdbc:h2:./data/database</entry>
    <entry key='database.user'>sa</entry>
    <entry key='database.password'></entry>

    <!-- Public URL behind nginx, without trailing slash -->
    <entry key='web.url'>https://onibus.exemplo.ufpa.br</entry>

    <!-- Other fronts allowed to call the API from the browser (CORS), comma separated, exact match
         (scheme + host + port, no path). Also accepted by the public routes. See docs/public-access.md -->
    <entry key='web.origin'>http://localhost:8000,https://ceamazon.com.br</entry>
    <!-- Only if those fronts log in (session cookie sent cross-site). Needs HTTPS on this server -->
    <!-- <entry key='web.sameSiteCookie'>None</entry> -->

    <entry key='database.registerUnknown'>false</entry>

    <!-- Only the protocols in use: Watch (GPS trackers, TCP 5093) and OsmAnd (5055 / HTTPS).
         Without this Traccar opens a port for every supported protocol. -->
    <entry key='protocols.enable'>watch,osmand</entry>

    <entry key='public.enable'>true</entry>
    <entry key='public.features'>devices,positions,stream</entry>

    <!-- Public routes accept the front's own origin plus web.origin. See docs/public-access.md -->
    <!-- <entry key='public.allowedOrigins'>https://outro-front.ufpa.br</entry> -->
    <!-- <entry key='public.apiKeys'>key-for-an-authorized-app</entry> -->
    <!-- <entry key='public.rateLimit'>600</entry> -->
    <!-- <entry key='public.maxStreams'>50</entry> -->

</properties>
