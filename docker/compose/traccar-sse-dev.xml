<?xml version='1.0' encoding='UTF-8'?>

<!DOCTYPE properties SYSTEM 'http://java.sun.com/dtd/properties.dtd'>

<properties>

    <!-- Development config for docker/compose/traccar-sse-dev.yaml. See docs/desenvolvimento.md. -->

    <entry key='database.driver'>org.h2.Driver</entry>
    <entry key='database.url'>jdbc:h2:./data/database</entry>
    <entry key='database.user'>sa</entry>
    <entry key='database.password'></entry>

    <entry key='logger.console'>true</entry>
    <entry key='logger.fullStackTraces'>true</entry>

    <entry key='public.enable'>true</entry>
    <entry key='public.features'>devices,positions,stream</entry>

    <!-- The Vite container (front service) sends the browser origin; same-origin already covers it through
         X-Forwarded-Host. Listed explicitly so a VITE_API_URL setup without the proxy also works. -->
    <entry key='public.allowedOrigins'>http://localhost:5173</entry>

    <!-- Only the protocols in use (Watch trackers, OsmAnd for tests): keeps the container from opening
         hundreds of protocol ports -->
    <entry key='protocols.enable'>watch,osmand</entry>

</properties>
