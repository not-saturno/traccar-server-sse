# Reverse proxy for traccar-server-sse with automatic HTTPS. See docs/deploy.md and docs/imagem-docker.md.
#
# Environment:
#   SERVER_NAME  public domain (e.g. onibus.exemplo.ufpa.br, DNS pointing to this server) or the server public IP
#   ACME_EMAIL   contact for certificate expiry notices
#   TLS_MODE     how the certificate is obtained (default acme):
#                  acme      domain: Let's Encrypt / ZeroSSL, 90 days, renewed automatically
#                  ip        public IP without a domain: Let's Encrypt "shortlived" profile (~6 days, renewed
#                            automatically). Ports 80 and 443 must be reachable from the internet
#                  internal  private IP or no internet access to 80/443: Caddy's own CA, browsers show a warning

{
	email {$ACME_EMAIL}

	# Browsers send no SNI for https://<IP> (TLS forbids IPs in SNI). Without SNI Caddy picks the certificate by
	# the connection's local IP, which inside Docker is the container IP (172.x), so nothing matches and the
	# handshake fails (ERR_SSL_PROTOCOL_ERROR). This makes those connections use the SERVER_NAME certificate.
	# No effect for domains: clients always send SNI for them.
	default_sni {$SERVER_NAME}
}

# Certificate modes, picked by TLS_MODE ({$...} is replaced before the Caddyfile is parsed)
(tls-acme) {
	# Caddy's automatic HTTPS for the domain in SERVER_NAME
}

(tls-ip) {
	tls {
		# Only Let's Encrypt's "shortlived" profile issues certificates for IP addresses.
		# Explicit issuer: with a profile set, every configured CA must support it (no ZeroSSL fallback)
		issuer acme {
			dir https://acme-v02.api.letsencrypt.org/directory
			email {$ACME_EMAIL}
			profile shortlived
		}
	}
}

(tls-internal) {
	tls internal
}

{$SERVER_NAME} {
	import tls-{$TLS_MODE:acme}

	request_body {
		max_size 10MB
	}

	# Front (served by Traccar from web/), REST API, SSE, WebSocket and OsmAnd over HTTPS (POST /).
	# Caddy flushes text/event-stream right away and upgrades WebSocket on its own.
	# No "encode" here: Traccar already compresses, and compressing SSE would hold events back.
	reverse_proxy traccar:8082 {
		# Traccar reads CF-Connecting-IP, then X-Real-IP, then X-Forwarded-For: never trust the client's values
		header_up -CF-Connecting-IP
		header_up X-Real-IP {remote_host}

		# Traccar does not mark the session cookie as Secure behind a TLS proxy
		header_down Set-Cookie "^(JSESSIONID=.*)$" "$1; Secure"
	}
}
